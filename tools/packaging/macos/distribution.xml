<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Audio Backuper @VERSION@</title>
    <organization>com.rozetki</organization>
    <!-- "For all users" needs an administrator; "only for me" installs into the home folder. -->
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="true"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="au"/>
        <line choice="vst3"/>
    </choices-outline>
    <choice id="au" title="Audio Unit" description="Logic Pro, GarageBand, Ableton Live, Reaper">
        <pkg-ref id="com.rozetki.audiobackuper.au"/>
    </choice>
    <choice id="vst3" title="VST3" description="Ableton Live, Reaper, Cubase, Studio One">
        <pkg-ref id="com.rozetki.audiobackuper.vst3"/>
    </choice>
    <pkg-ref id="com.rozetki.audiobackuper.au" version="@VERSION@">au.pkg</pkg-ref>
    <pkg-ref id="com.rozetki.audiobackuper.vst3" version="@VERSION@">vst3.pkg</pkg-ref>
</installer-gui-script>
